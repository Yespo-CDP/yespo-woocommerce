#: backend/views/settings.php:7
msgid "My account"
msgstr "Mein Konto"

#: backend/views/settings.php:13
msgid "Data synchronization"
msgstr "Datensynchronisierung"

#: backend/views/settings.php:14
msgid "Synchronize contacts and orders for subsequent analysis and efficient data utilization using Yespo marketing automation tools"
msgstr "Synchronisieren Sie Kontakte und Bestellungen für weitere Analysen und eine effektive Datennutzung mit den Marketing-Automatisierungstools von Yespo"

#: functions/functions.php:21
msgid "Customers"
msgstr "Kunden"

#: functions/functions.php:22
msgid "Orders"
msgstr "Bestellungen"

#: functions/functions.php:23
msgid "Synchronized"
msgstr "Synchronisiert"

#: functions/functions.php:24
msgid "Failed"
msgstr "Fehlgeschlagen"

#: functions/functions.php:25
msgid "Total"
msgstr "Gesamt"

#: backend/views/settings.php:27
msgid "API Key"
msgstr "API-Schlüssel"

#: backend/views/settings.php:33
msgid "The API key to connect the account can be received by the"
msgstr "Den API-Schlüssel zum Verbinden Ihres Kontos können Sie über den folgenden"

#: backend/views/settings.php:33
msgid "link"
msgstr "link erhalten"

#: backend/views/settings.php:39
msgid "Synchronize"
msgstr "Synchronisieren"

#: backend/views/settings.php:51
msgid "Invalid API key"
msgstr "Ungültiger API-Schlüssel"

#: backend/views/settings.php:56
msgid "The first data export will take some time; it will happen in the background, and it is not necessary to stay on the page"
msgstr "Der erste Datenexport wird einige Zeit dauern; er läuft im Hintergrund und Sie müssen nicht auf der Seite bleiben"

#: backend/views/settings.php:61
msgid "Synchronization progress"
msgstr "Fortschritt der Synchronisierung"

#: backend/views/settings.php:64
msgid "Pause"
msgstr "Pause"

#: backend/views/settings.php:65
msgid "Pause synchronization. Are you sure you want to pause synchronization?"
msgstr "Synchronisierung anhalten. Möchten Sie die Synchronisierung wirklich anhalten?"

#: backend/views/settings.php:66
msgid "Cancel"
msgstr "Stornieren"

#: backend/views/settings.php:73
msgid "The synchronization process has been paused; you can resume it from the moment of pausing without losing the previous progress"
msgstr "Der Synchronisierungsprozess wurde angehalten; Sie können ihn ab dem Zeitpunkt der Anhaltung fortsetzen, ohne den vorherigen Fortschritt zu verlieren"

#: backend/views/settings.php:78
msgid "Resume"
msgstr "Fortsetzen"

#: backend/views/settings.php:83
msgid "Some error have occurred. Try to resume synchronization. If it doesn’t help, contact Support"
msgstr "Die ausgehende Serveraktivität ist blockiert. Bitte wenden Sie sich an Ihren Hosting-Anbieter. Die Synchronisierung wird automatisch ohne Datenverlust fortgesetzt"

#: backend/views/settings.php:361
msgid "Invalid API key. Please delete the plugin and start the configuration from scratch using a valid API key. No data will be lost."
msgstr "Ungültiger API-Schlüssel. Entfernen Sie das Plugin und starten Sie die Konfiguration erneut mit einem gültigen API-Schlüssel. Die Daten gehen nicht verloren."

#: backend/views/settings.php:362
msgid "Outgoing activity on the server is blocked. Please contact your provider to resolve this issue. Data synchronization will automatically be resumed without any data loss once the issue is resolved."
msgstr "Die ausgehende Serveraktivität ist blockiert. Bitte wenden Sie sich an Ihren Hosting-Anbieter. Die Synchronisierung wird automatisch ohne Datenverlust fortgesetzt."


#: backend/views/settings.php:86
msgid "Contact Support"
msgstr "Support kontaktieren"

#: backend/views/settings.php:87
msgid "Data is successfully synchronized"
msgstr "Daten erfolgreich synchronisiert"

#: integrations/esputnik/Yespo_Localization.php:87
msgid "Web tracking is successfully configured"
msgstr "Web-Tracking wurde erfolgreich eingerichtet"

#: backend/views/settings.php:89
msgid "Data synchronization has started"
msgstr "Die Datensynchronisierung wurde gestartet"

#: integrations/esputnik/Yespo_Localization.php:19
