#: backend/views/settings.php:14
msgid "Synchronize contacts and orders for subsequent analysis and efficient data utilization using Yespo marketing automation tools"
msgstr "Sincronizza contatti e ordini per ulteriori analisi e un utilizzo efficace dei dati con gli strumenti di automazione marketing Yespo"

